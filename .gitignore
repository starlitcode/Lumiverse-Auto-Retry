# dependencies
node_modules/

# secrets and local env
.env
.env.*

# logs and caches
*.log
.cache/
.bun/

# build info from incremental typechecks
*.tsbuildinfo

# written by `bun install`. typescript is the only dependency and the install
# path is a clone, so nobody needs a pinned copy of it.
bun.lock
bun.lockb

# editor and OS junk
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# note: dist/ is intentionally NOT ignored.
# Lumiverse loads dist/frontend.js, so it is committed prebuilt.
